<mujoco model="robot">
  <compiler angle="radian" meshdir="/home/shourya/rl2/meshes/" autolimits="true"/>

  <option gravity="0 0 -9.81" integrator="implicitfast"/>

  <default>
    <joint damping="0.01" frictionloss="0.001"/>
    <geom contype="1" conaffinity="1" friction="0.9 0.005 0.0001"/>
    <position kp="10" kv="0.5"/>
  </default>

  <asset>
    <mesh name="disc" file="disc.stl" scale="0.001 0.001 0.001"/>
    <mesh name="base_link" file="base_link.stl" scale="0.001 0.001 0.001"/>
    <mesh name="pendulum" file="pendulum.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <worldbody>
    <!-- base_link is the root; fixed to world (add a free/slide joint here if it should move) -->
    <body name="base_link" pos="0 0 0" euler="0 0 0">
      <inertial pos="6.171755727700128e-05 -1.6072059530088367e-07 0.0631025698792516"
                mass="1.67411359545379"
                fullinertia="0.0027485039526724663 0.0027478860684484723 0.001784527115398101 -2.315655587761894e-08 3.7468013762829782e-06 -1.6748510881927868e-07"/>
      <geom name="base_link_visual" type="mesh" mesh="base_link" pos="0 0 0" euler="0 0 0"
            contype="0" conaffinity="0" group="1"/>
      <geom name="base_link_collision" type="mesh" mesh="base_link" pos="0 0 0" euler="0 0 0"
            group="3"/>

      <!-- disc: driven by base_link_Revolute-2, continuous -> hinge, no limits -->
      <body name="disc" pos="0.0 0.0 0.1178693" euler="0 0 0">
        <inertial pos="0.007668534346231335 -1.8805171185290753e-06 0.03776049660227763"
                  mass="0.9393032348997049"
                  fullinertia="0.0005564364294889344 0.0006883057581110914 0.0006413763359421145 -2.309070493190923e-08 -6.230644000451506e-05 -4.326287667606388e-08"/>
        <joint name="base_link_Revolute-2" type="hinge" axis="0 0 1" pos="0 0 0" limited="false"/>
        <geom name="disc_visual" type="mesh" mesh="disc" pos="7.267471740958731e-19 -2.220446049250313e-18 -0.1198693" euler="0 0 0"
              contype="0" conaffinity="0" group="1"/>
        <geom name="disc_collision" type="mesh" mesh="disc" pos="7.267471740958731e-19 -2.220446049250313e-18 -0.1198693" euler="0 0 0"
              group="3"/>

        <!-- pendulum: driven by disc_Revolute-3, continuous -> hinge, no limits.
             Body itself carries NO rotation (matches reference URDF pattern)
             only the geoms are rotated below to align the mesh visually. Keeping
             the joint frame unrotated means axis="1 0 0" is literally the disc's
             radial/X axis with no compounding through a body-level euler. -->
        <body name="pendulum" pos="-0.059500000000000004 0.0 0.049">
          <inertial pos="-0.005730913802140139 2.5576754011798562e-08 -0.04117956921457129"
                    mass="0.023292673446883957"
                    fullinertia="2.93040412e-05 2.95079264e-05 3.27071903e-07 -3.04712959e-12 -1.20089252e-06 -2.07421405e-11"/>
          <joint name="disc_Revolute-3" type="hinge" axis="1 0 0" pos="0 0 0" limited="false"/>
          <geom name="pendulum_visual" type="mesh" mesh="pendulum" pos="0.0595 -2.220446049250313e-18 -0.1688693" euler="0 0 0"
                contype="0" conaffinity="0" group="1"/>
          <geom name="pendulum_collision" type="mesh" mesh="pendulum" pos="0.0595 -2.220446049250313e-18 -0.1688693" euler="0 0 0"
                group="3"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- Reaction-wheel drive: MOTOR (torque), not position.
         A position actuator here would servo the disc to a fixed angle, absorbing
         almost all torque as self-correction instead of transmitting reaction
         torque into the pendulum that's why nothing moved before. -->
    <motor name="base_link_Revolute-2_act" joint="base_link_Revolute-2" ctrlrange="-2 2" gear="1"/>

    <!-- pendulum joint stays UNACTUATED it must swing freely and only feel
         torque reflected from the reaction wheel. No actuator on this joint. -->
  </actuator>

  <sensor>
    <jointpos name="disc_Revolute-3_pos" joint="disc_Revolute-3"/>
    <jointvel name="disc_Revolute-3_vel" joint="disc_Revolute-3"/>
    <jointpos name="base_link_Revolute-2_pos" joint="base_link_Revolute-2"/>
    <jointvel name="base_link_Revolute-2_vel" joint="base_link_Revolute-2"/>
  </sensor>
</mujoco>